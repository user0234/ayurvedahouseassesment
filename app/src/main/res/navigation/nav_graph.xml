<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph.xml"
    app:startDestination="@id/homeScreen">

    <fragment
        android:id="@+id/homeScreen"
        android:name="com.example.ayurvedahouseassesment.presentation.screens.homeScreen.HomeScreen"
        android:label="fragment_home_screen"
        tools:layout="@layout/fragment_home_screen">
        <action
            android:id="@+id/action_homeScreen_to_detailScreen"
            app:destination="@id/detailScreen">
            <argument
                android:name="shoppingItem"
                app:argType="com.example.ayurvedahouseassesment.domain.model.ShoppingItem" />
        </action>
        <action
            android:id="@+id/action_homeScreen_to_cartScreen"
            app:destination="@id/cartScreen" />
    </fragment>
    <fragment
        android:id="@+id/detailScreen"
        android:name="com.example.ayurvedahouseassesment.presentation.screens.detailScreen.DetailScreen"
        android:label="fragment_detail_screen"
        tools:layout="@layout/fragment_detail_screen">
        <argument
            android:name="shoppingItem"
            app:argType="com.example.ayurvedahouseassesment.domain.model.ShoppingItem" />
        <action
            android:id="@+id/action_detailScreen_to_cartScreen"
            app:destination="@id/cartScreen" />
    </fragment>
    <fragment
        android:id="@+id/cartScreen"
        android:name="com.example.ayurvedahouseassesment.presentation.screens.cartScreen.CartScreen"
        android:label="fragment_cart_screen"
        tools:layout="@layout/fragment_cart_screen" />
</navigation>